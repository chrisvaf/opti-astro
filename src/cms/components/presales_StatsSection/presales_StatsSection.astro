---
import type {
    PresalesStatsSectionFragment,
    DisplaySettingsFragment,
} from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { isEditContext } from '../../shared/utils.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    key: string;
    data: PresalesStatsSectionFragment;
    displaySettings: DisplaySettingsFragment[];
    contentPayload: ContentPayload;
}

const { key, data } = Astro.props as Props;

type StatItem = Extract<NonNullable<NonNullable<PresalesStatsSectionFragment['StatItems']>[number]>, { __typename: 'presales_StatItem' }>;

const statItems = (data?.StatItems || []).filter((item): item is StatItem => item?.__typename === 'presales_StatItem');

// Map icon key to inline SVG path data
function getIconSvg(iconKey: string | null | undefined): string {
    switch (iconKey) {
        case 'users':
            return `<circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M21 21v-2a4 4 0 0 0-3-3.85"/>`;
        case 'clock':
            return `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`;
        case 'trending_up':
            return `<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>`;
        case 'heart':
            return `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`;
        case 'award':
            return `<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>`;
        case 'star':
            return `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`;
        case 'shield':
            return `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`;
        default:
            return `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`;
    }
}

const componentClass = 'component-presales-stats-section';
---

<section
    class:list={[componentClass, 'bg-white py-16 lg:py-24']}
    data-epi-block-id={isCmsEdit && key || undefined}
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        <div class="text-center mb-12 lg:mb-16">
            {data?.SectionLabel && (
                <p class="text-sm font-semibold text-[#2EA84A] uppercase tracking-widest mb-3">
                    {data.SectionLabel}
                </p>
            )}
            {data?.Heading && (
                <h2 class="text-3xl lg:text-4xl font-extrabold text-[#003087] mb-4">
                    {data.Heading}
                </h2>
            )}
            {data?.SectionDescription?.html && (
                <div
                    class="text-gray-500 max-w-2xl mx-auto text-base leading-relaxed prose prose-gray mx-auto"
                    set:html={data.SectionDescription.html}
                />
            )}
        </div>

        <!-- Stat cards grid -->
        {statItems.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                {statItems.map((item) => (
                    <div class="group flex flex-col items-center text-center p-8 border-2 border-gray-100 rounded-2xl transition-all duration-300 hover:border-[#2EA84A] hover:shadow-lg">
                        <!-- Icon -->
                        <div class="w-16 h-16 bg-[#2EA84A] rounded-2xl flex items-center justify-center mb-6 shrink-0">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-8 h-8 text-white"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                set:html={getIconSvg(item?.IconKey)}
                            />
                        </div>
                        <!-- Stat number -->
                        <div class="text-4xl font-extrabold text-[#003087] mb-1">
                            {item?.StatNumber}
                        </div>
                        <!-- Stat label -->
                        <div class="text-sm font-semibold text-[#2EA84A] uppercase tracking-wide mb-3">
                            {item?.StatLabel}
                        </div>
                        <!-- Description -->
                        {item?.Description && (
                            <p class="text-sm text-gray-500 leading-relaxed">
                                {item.Description}
                            </p>
                        )}
                    </div>
                ))}
            </div>
        )}
    </div>
</section>
