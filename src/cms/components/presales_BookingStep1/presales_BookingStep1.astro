---
import type {
    PresalesBookingStep1Fragment,
    DisplaySettingsFragment,
} from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { isEditContext } from '../../shared/utils.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    key: string;
    data: PresalesBookingStep1Fragment;
    displaySettings: DisplaySettingsFragment[];
    contentPayload: ContentPayload;
}

const { key, data } = Astro.props as Props;

type CareTypeItem = Extract<NonNullable<NonNullable<PresalesBookingStep1Fragment['CareTypeItems']>[number]>, { __typename: 'presales_CareTypeItem' }>;
type LocationItem = Extract<NonNullable<NonNullable<PresalesBookingStep1Fragment['LocationItems']>[number]>, { __typename: 'presales_LocationItem' }>;

const careTypeItems = (data?.CareTypeItems || []).filter((item): item is CareTypeItem => item?.__typename === 'presales_CareTypeItem');
const locationItems = (data?.LocationItems || []).filter((item): item is LocationItem => item?.__typename === 'presales_LocationItem');

const defaultStep = data?.DefaultStep === '2' ? 2 : 1;
const zipDefault = data?.ZipCodeDefault || '';

const steps = [
    { label: 'Care Type' },
    { label: 'Location' },
    { label: 'Provider' },
    { label: 'Date & Time' },
    { label: 'Your Info' },
    { label: 'Confirm' },
];

function getIconSvg(iconKey: string | null | undefined): string {
    switch (iconKey) {
        case 'zap':
            return `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`;
        case 'stethoscope':
            return `<path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><circle cx="15" cy="19" r="2"/><path d="M16.4 17a3 3 0 1 1 3.3 3.8 3 3 0 0 1-3-3.3"/>`;
        case 'video':
            return `<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>`;
        case 'heart':
            return `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`;
        case 'brain':
            return `<path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/>`;
        default:
            return `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`;
    }
}

const componentClass = 'component-presales-booking-step1';
---

<section
    class:list={[componentClass, 'bg-[#F7F8FA] py-12 lg:py-16']}
    data-epi-block-id={isCmsEdit && key || undefined}
>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        {(data?.SectionLabel || data?.SectionHeading) && (
            <div class="text-center mb-8">
                {data?.SectionLabel && (
                    <p class="text-sm font-semibold text-[#2EA84A] uppercase tracking-widest mb-2">
                        {data.SectionLabel}
                    </p>
                )}
                {data?.SectionHeading && (
                    <h2 class="text-2xl lg:text-3xl font-extrabold text-[#003087]">
                        {data.SectionHeading}
                    </h2>
                )}
            </div>
        )}

        <!-- Wizard shell -->
        <div
            class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden"
            x-data={`{ step: ${defaultStep}, careType: null, location: null, zip: '${zipDefault}' }`}
        >

            <!-- Step indicator header -->
            <div class="px-6 sm:px-8 pt-6 sm:pt-8 pb-5 border-b border-gray-100 bg-gray-50/50">

                <!-- Desktop: labeled step circles -->
                <div class="hidden sm:flex items-center justify-between w-full">
                    {steps.map((stepDef, index) => {
                        const stepNum = index + 1;
                        return (
                            <Fragment>
                                <div class="flex flex-col items-center gap-1.5 flex-shrink-0">
                                    <div
                                        :class={`step === ${stepNum} ? 'bg-[#003087] text-white ring-4 ring-[#003087]/20' : step > ${stepNum} ? 'bg-[#2EA84A] text-white' : 'bg-gray-100 text-gray-400'`}
                                        class="w-9 h-9 rounded-full flex items-center justify-center font-semibold text-sm"
                                    >
                                        <template x-if={`step > ${stepNum}`}>
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        </template>
                                        <template x-if={`step <= ${stepNum}`}>
                                            <span>{stepNum}</span>
                                        </template>
                                    </div>
                                    <span
                                        :class={`step === ${stepNum} ? 'text-[#003087]' : step > ${stepNum} ? 'text-[#2EA84A]' : 'text-gray-400'`}
                                        class="text-xs font-medium whitespace-nowrap"
                                    >
                                        {stepDef.label}
                                    </span>
                                </div>
                                {index < steps.length - 1 && (
                                    <div
                                        :class={`step > ${stepNum} ? 'bg-[#2EA84A]/40' : 'bg-gray-200'`}
                                        class="flex-1 h-0.5 mx-2 mb-5 transition-colors duration-300"
                                    />
                                )}
                            </Fragment>
                        );
                    })}
                </div>

                <!-- Mobile: progress bar -->
                <div class="sm:hidden">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-semibold text-[#003087]">
                            Step <span x-text="step"></span> of 6:
                            <span x-text="['Care Type','Location','Provider','Date & Time','Your Info','Confirm'][step - 1]"></span>
                        </span>
                        <span class="text-xs text-gray-500" x-text="`${Math.round(step / 6 * 100)}%`"></span>
                    </div>
                    <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                        <div
                            class="h-full rounded-full bg-[#2EA84A] transition-all duration-300"
                            :style="`width: ${Math.round(step / 6 * 100)}%`"
                        ></div>
                    </div>
                    <div class="flex justify-center gap-2 mt-3">
                        {steps.map((_, index) => (
                            <div
                                :class={`step === ${index + 1} ? 'w-6 bg-[#003087]' : step > ${index + 1} ? 'w-2 bg-[#2EA84A]' : 'w-2 bg-gray-200'`}
                                class="h-2 rounded-full transition-all duration-200"
                            />
                        ))}
                    </div>
                </div>
            </div>

            <!-- Context banner -->
            {data?.ContextBannerText && (
                <div class="px-6 sm:px-8 py-3 bg-[#003087]/5 border-b border-[#003087]/10 flex items-center gap-3">
                    <div class="w-7 h-7 rounded-full bg-[#003087] flex items-center justify-center shrink-0">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <p class="text-sm text-[#003087] font-semibold flex items-center gap-2 flex-wrap">
                        <span>{data.ContextBannerText}</span>
                        <span x-show="step === 2" style="display: none;" class="flex items-center gap-2">
                            <span class="text-gray-300 select-none">&bull;</span>
                            <button
                                type="button"
                                @click="step = 1; careType = null"
                                class="text-[#2EA84A] underline hover:no-underline font-medium"
                            >
                                Change
                            </button>
                        </span>
                    </p>
                </div>
            )}

            <!-- Step content -->
            <div class="px-6 sm:px-8 py-6 sm:py-8 min-h-[420px]">

                <!-- ── Step 1: Care Type ── -->
                <div
                    x-show="step === 1"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                >
                    <div class="mb-6">
                        {data?.Heading && (
                            <h2 class="text-2xl font-bold text-[#003087] mb-1">{data.Heading}</h2>
                        )}
                        {data?.Subheading && (
                            <p class="text-gray-500 text-sm">{data.Subheading}</p>
                        )}
                    </div>

                    {careTypeItems.length > 0 && (
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                            {careTypeItems.map((item) => (
                                <button
                                    type="button"
                                    x-on:click={`careType = '${item.IconKey}'`}
                                    :class={`careType === '${item.IconKey}' ? 'border-[#00BFB3] bg-[#E0F7F6] shadow-md' : 'border-gray-200 bg-white hover:border-[#00BFB3]/50 hover:shadow-sm'`}
                                    class="group relative flex flex-col items-start gap-3 p-5 rounded-xl border-2 text-left transition-all duration-200 w-full"
                                >
                                    <div
                                        :class={`careType === '${item.IconKey}' ? 'bg-[#00BFB3] text-white' : 'bg-gray-100 text-gray-500 group-hover:bg-[#E0F7F6] group-hover:text-[#00BFB3]'`}
                                        class="p-2.5 rounded-xl transition-colors duration-200"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-7 h-7"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                            set:html={getIconSvg(item.IconKey)}
                                        />
                                    </div>
                                    <div class="flex-1 w-full">
                                        <div class="flex items-start justify-between gap-2">
                                            <span
                                                :class={`careType === '${item.IconKey}' ? 'text-[#003087]' : 'text-gray-800'`}
                                                class="font-semibold text-base"
                                            >
                                                {item.Label}
                                            </span>
                                            <div
                                                x-show={`careType === '${item.IconKey}'`}
                                                class="w-5 h-5 rounded-full bg-[#00BFB3] flex items-center justify-center shrink-0 mt-0.5"
                                                style="display: none;"
                                            >
                                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                                    <path d="M2 6l3 3 5-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </div>
                                        </div>
                                        {item.Description && (
                                            <p class="text-gray-500 text-sm mt-1 leading-snug">{item.Description}</p>
                                        )}
                                    </div>
                                    {item.WaitTime && (
                                        <div
                                            :class={`careType === '${item.IconKey}' ? 'bg-[#003087] text-white' : 'bg-gray-100 text-gray-500'`}
                                            class="text-xs font-medium px-2.5 py-1 rounded-full transition-colors duration-200"
                                        >
                                            Available: {item.WaitTime}
                                        </div>
                                    )}
                                </button>
                            ))}
                        </div>
                    )}
                </div>

                <!-- ── Step 2: Location ── -->
                <div
                    x-show="step === 2"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 translate-x-2"
                    x-transition:enter-end="opacity-100 translate-x-0"
                    style="display: none;"
                >
                    <div class="mb-6">
                        {data?.LocationHeading && (
                            <h2 class="text-2xl font-bold text-[#003087] mb-1">{data.LocationHeading}</h2>
                        )}
                        {data?.LocationSubheading && (
                            <p class="text-gray-500 text-sm">{data.LocationSubheading}</p>
                        )}
                    </div>

                    <!-- ZIP search bar -->
                    <div class="flex gap-3 mb-6">
                        <div class="relative flex-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                            </svg>
                            <input
                                type="text"
                                x-model="zip"
                                placeholder="Enter ZIP code"
                                maxlength="5"
                                class="w-full pl-10 pr-4 py-3 border-2 border-gray-200 rounded-xl text-sm focus:outline-none focus:border-[#00BFB3] transition-colors"
                            />
                        </div>
                        <button
                            type="button"
                            class="px-5 py-3 bg-[#003087] hover:bg-[#004BB5] text-white font-semibold text-sm rounded-xl transition-colors flex items-center gap-2"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                            <span class="hidden sm:inline">Search</span>
                        </button>
                        <button
                            type="button"
                            class="px-4 py-3 border-2 border-gray-200 hover:border-[#00BFB3] text-gray-600 hover:text-[#00BFB3] text-sm rounded-xl transition-colors flex items-center gap-2 whitespace-nowrap"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                            </svg>
                            <span class="hidden sm:inline">Use My Location</span>
                        </button>
                    </div>

                    <!-- Location results -->
                    {locationItems.length > 0 && (
                        <div class="space-y-3">
                            <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">
                                {locationItems.length} location{locationItems.length !== 1 ? 's' : ''} near <span x-text="zip || 'you'"></span>
                            </p>
                            {locationItems.map((loc) => (
                                <button
                                    type="button"
                                    x-on:click={`location = '${loc.Name}'`}
                                    :class={`location === '${loc.Name}' ? 'border-[#00BFB3] bg-[#E0F7F6] shadow-sm' : 'border-gray-200 bg-white hover:border-[#00BFB3]/50 hover:shadow-sm'`}
                                    class="group w-full flex items-start justify-between gap-4 p-4 rounded-xl border-2 text-left transition-all duration-200"
                                >
                                    <div class="flex items-start gap-3 flex-1 min-w-0">
                                        <div
                                            :class={`location === '${loc.Name}' ? 'bg-[#00BFB3] text-white' : 'bg-gray-100 text-gray-500 group-hover:bg-[#E0F7F6] group-hover:text-[#00BFB3]'`}
                                            class="mt-0.5 p-2 rounded-lg shrink-0 transition-colors"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                                            </svg>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-start gap-2 flex-wrap">
                                                <span
                                                    :class={`location === '${loc.Name}' ? 'text-[#003087]' : 'text-gray-800'`}
                                                    class="font-semibold text-sm"
                                                >
                                                    {loc.Name}
                                                </span>
                                                {loc.Miles && (
                                                    <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full shrink-0">
                                                        {loc.Miles} mi
                                                    </span>
                                                )}
                                            </div>
                                            {(loc.Address || loc.City) && (
                                                <p class="text-gray-500 text-xs mt-0.5">
                                                    {[loc.Address, loc.City].filter(Boolean).join(', ')}
                                                </p>
                                            )}
                                            <div class="flex items-center gap-3 mt-2 flex-wrap">
                                                {loc.Hours && (
                                                    <span class="flex items-center gap-1 text-xs text-gray-500">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                                        </svg>
                                                        {loc.Hours}
                                                    </span>
                                                )}
                                                {loc.NextAvailable && (
                                                    <span class="text-xs font-medium text-[#2EA84A]">
                                                        Next: {loc.NextAvailable}
                                                    </span>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        :class={`location === '${loc.Name}' ? 'text-[#00BFB3]' : 'text-gray-300 group-hover:text-[#00BFB3]'`}
                                        class="w-4 h-4 shrink-0 mt-1 transition-colors"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <polyline points="9 18 15 12 9 6"/>
                                    </svg>
                                </button>
                            ))}
                        </div>
                    )}
                </div>

            </div>

            <!-- Navigation footer -->
            <div class="px-6 sm:px-8 py-4 border-t border-gray-100 flex items-center justify-between bg-gray-50/30">

                <!-- Back button -->
                <button
                    type="button"
                    :disabled="step === 1"
                    @click="if (step > 1) step--"
                    :class="step === 1 ? 'text-gray-300 cursor-not-allowed' : 'text-gray-600 hover:text-[#003087] hover:bg-gray-100'"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200"
                    aria-label="Back"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                    Back
                </button>

                <!-- Step counter (desktop) -->
                <span class="text-sm text-gray-400 hidden sm:block" x-text="`${step} of 6`"></span>

                <!-- Continue button -->
                <button
                    type="button"
                    :disabled="step === 1 ? !careType : !location"
                    @click="if (step === 1 ? careType : location) step++"
                    :class="(step === 1 ? careType : location) ? 'bg-[#003087] text-white hover:bg-[#003087]/90 cursor-pointer' : 'bg-gray-200 text-gray-400 cursor-not-allowed'"
                    class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200"
                    aria-label="Continue to next step"
                >
                    {data?.ContinueButtonLabel || 'Continue'}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </button>
            </div>

        </div>
    </div>
</section>
